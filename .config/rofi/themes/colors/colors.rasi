/* Frutiger Aero - role names only.
 *
 * Every value here comes from ~/.config/theme/colors.rasi, which home-manager
 * generates from palette.nix - and palette.nix is itself generated from the
 * wallpaper by assets/gen-palette.py. There are deliberately no hex values in
 * this file: change the wallpaper, re-run the script, rebuild, and the whole
 * system follows. */
@import "/home/fede/.config/theme/colors.rasi"

* {
    background:     @aero-bg;
    background-alt: @aero-bg-alt;
    background-sec: @aero-bg-sec;
    foreground:     @aero-foam;
    selected:       @aero-gloss;
    active:         @aero-sun;
    urgent:         @aero-coral;
    highlight:      @aero-highlight;

    glass-panel:    @aero-glass-panel;
    glass-raised:   @aero-glass-raised;
    glass-sunken:   @aero-glass-sunken;
    glass-selected: @aero-glass-selected;
    rim:            @aero-rim-soft;
    rim-strong:     @aero-rim-strong;
}
